{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XTJSON",
  "scopeName": "source.xtjson",
  "comment": "TextMate grammar for XTJSON (docs/xtjson-spec-en.md, Appendix A). It is lexical: it highlights tokens and marks some invalid notations, but it does not check the structure of the document.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#property-names" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#literals" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.xtjson",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.xtjson" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.xtjson" } }
        },
        {
          "name": "comment.line.double-slash.xtjson",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.xtjson" } }
        },
        {
          "name": "comment.line.number-sign.xtjson",
          "match": "(#).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.xtjson" } }
        }
      ]
    },
    "directives": {
      "comment": "The directive %strict (6.5): '%strict' as one token, then ':' and true or false. Other directives and '%' without a name are errors; whether the directive stands at the start of the document is not checked.",
      "patterns": [
        {
          "match": "(%strict)(?![A-Za-z0-9_$])(?:[ \\t]*(:))?",
          "captures": {
            "1": { "name": "keyword.control.directive.xtjson" },
            "2": { "name": "punctuation.separator.key-value.xtjson" }
          }
        },
        { "name": "invalid.illegal.unknown-directive.xtjson", "match": "%[A-Za-z_$][A-Za-z0-9_$]*" },
        { "name": "invalid.illegal.directive.xtjson", "match": "%" }
      ]
    },
    "property-names": {
      "comment": "A name: an identifier or a string that is followed by ':' on the same line (7.2). A name across several lines is highlighted as a string, because a TextMate grammar cannot look beyond the end of the line.",
      "patterns": [
        {
          "name": "support.type.property-name.xtjson",
          "match": "(?<![A-Za-z0-9_$])[A-Za-z_$][A-Za-z0-9_$]*(?=[ \\t]*:)"
        },
        {
          "name": "support.type.property-name.xtjson",
          "begin": "\"(?=(?:[^\"\\\\\\n]|\\\\.)*\"[ \\t]*:)",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.support.type.property-name.begin.xtjson" } },
          "endCaptures": { "0": { "name": "punctuation.support.type.property-name.end.xtjson" } },
          "patterns": [{ "include": "#string-content" }]
        },
        {
          "name": "support.type.property-name.xtjson",
          "begin": "'(?=(?:[^'\\\\\\n]|\\\\.)*'[ \\t]*:)",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.support.type.property-name.begin.xtjson" } },
          "endCaptures": { "0": { "name": "punctuation.support.type.property-name.end.xtjson" } },
          "patterns": [{ "include": "#string-content" }]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "Three quotation marks in a row do not delimit a string: they are an empty string directly followed by another string, which is always an error.",
          "name": "invalid.illegal.triple-quote.xtjson",
          "match": "\"\"\"|'''"
        },
        {
          "name": "string.quoted.double.xtjson",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.xtjson" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.xtjson" } },
          "patterns": [{ "include": "#string-content" }]
        },
        {
          "name": "string.quoted.single.xtjson",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.xtjson" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.xtjson" } },
          "patterns": [{ "include": "#string-content" }]
        }
      ]
    },
    "string-content": {
      "comment": "A string may extend across several lines: tab and line breaks may appear unescaped, every other control character must be escaped (8.1).",
      "patterns": [
        { "include": "#escapes" },
        { "name": "invalid.illegal.unescaped-control-character.xtjson", "match": "[\\x{00}-\\x{08}\\x{0B}\\x{0C}\\x{0E}-\\x{1F}]" }
      ]
    },
    "escapes": {
      "comment": "The escape sequences of the table in 8.2, including the line continuation, a backslash at the end of the line; every other sequence with a backslash is an error, also a backslash followed by white space.",
      "patterns": [
        {
          "name": "constant.character.escape.xtjson",
          "match": "\\\\(?:[\"'\\\\/bfnrtv]|0(?![0-9])|x\\h{2}|u\\h{4}|u\\{0*(?![dD][89a-fA-F]\\h{2}\\})(?:\\h{1,5}|10\\h{4})\\})"
        },
        { "name": "constant.character.escape.line-continuation.xtjson", "match": "\\\\$" },
        { "name": "invalid.illegal.unrecognized-string-escape.xtjson", "match": "\\\\.?" }
      ]
    },
    "numbers": {
      "comment": "Numbers (9.1 to 9.3) with an optional suffix from 9.5: n only after an integer, the other suffixes after every number. Anything else that begins like a number is an error.",
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_$.])(-?(?:0[xX]\\h(?:_?\\h)*|0[oO][0-7](?:_?[0-7])*|0[bB][01](?:_?[01])*|0|[1-9](?:_?[0-9])*))(n)(?![A-Za-z0-9_$.])",
          "captures": {
            "1": { "name": "constant.numeric.xtjson" },
            "2": { "name": "keyword.other.unit.suffix.xtjson" }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_$.])(-?(?:0[xX]\\h(?:_?\\h)*|0[oO][0-7](?:_?[0-7])*|0[bB][01](?:_?[01])*|(?:0|[1-9](?:_?[0-9])*)(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?))(min|ms|mb|m|kb|k|s|h|pct)?(?![A-Za-z0-9_$.])",
          "captures": {
            "1": { "name": "constant.numeric.xtjson" },
            "2": { "name": "keyword.other.unit.suffix.xtjson" }
          }
        },
        {
          "name": "invalid.illegal.number.xtjson",
          "match": "(?<![A-Za-z0-9_$.])(?:-?[0-9.](?:[eE][+-]|[A-Za-z0-9_$.])*|-)"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "comment": "The literals of 6.4; nil is the same value as null.",
          "name": "constant.language.xtjson",
          "match": "(?<![A-Za-z0-9_$])(?:true|false|null|nil)(?![A-Za-z0-9_$])"
        },
        {
          "comment": "Any other identifier that is not followed by ':' on its line: a name whose ':' follows on a later line, or an error at a value position (6.4). A lexical grammar cannot tell them apart, so it is not marked as invalid.",
          "name": "variable.other.xtjson",
          "match": "(?<![A-Za-z0-9_$])[A-Za-z_$][A-Za-z0-9_$]*"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.definition.dictionary.begin.xtjson", "match": "\\{" },
        { "name": "punctuation.definition.dictionary.end.xtjson", "match": "\\}" },
        { "name": "punctuation.definition.array.begin.xtjson", "match": "\\[" },
        { "name": "punctuation.definition.array.end.xtjson", "match": "\\]" },
        { "name": "punctuation.separator.key-value.xtjson", "match": ":" },
        { "name": "punctuation.separator.comma.xtjson", "match": "," },
        { "comment": "'=' does not occur in XTJSON outside strings and comments.", "name": "invalid.illegal.xtjson", "match": "=" }
      ]
    }
  }
}

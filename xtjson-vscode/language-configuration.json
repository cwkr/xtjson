{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "autoCloseBefore": ";:.,=}]) \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "-?[0-9][A-Za-z0-9_.]*|[A-Za-z_$][A-Za-z0-9_$]*",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}]*|\\[[^\\]]*)$",
    "decreaseIndentPattern": "^\\s*[}\\]],?\\s*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(//|#)\\s*#?region\\b",
      "end": "^\\s*(//|#)\\s*#?endregion\\b"
    }
  }
}

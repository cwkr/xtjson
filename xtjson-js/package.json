{
  "name": "@cwkr/xtjson",
  "version": "0.4.0",
  "description": "XTJSON parser and generator: a superset of JSON for files maintained by people, with an API like JSON",
  "keywords": [
    "xtjson",
    "json",
    "parser",
    "configuration",
    "comments",
    "ai-generated"
  ],
  "license": "MIT",
  "author": "Christian Winkler",
  "contributors": [
    {
      "name": "Claude Opus 5.5",
      "email": "noreply@anthropic.com"
    },
    {
      "name": "Claude Fable 5.2",
      "email": "noreply@anthropic.com"
    }
  ],
  "homepage": "https://github.com/cwkr/xtjson/tree/main/xtjson-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwkr/xtjson.git",
    "directory": "xtjson-js"
  },
  "bugs": "https://github.com/cwkr/xtjson/issues",
  "type": "module",
  "main": "./xtjson.js",
  "types": "./xtjson.d.ts",
  "exports": {
    ".": {
      "types": "./xtjson.d.ts",
      "default": "./xtjson.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "xtjson.js",
    "parser.js",
    "generator.js",
    "formatter.js",
    "shared.js",
    "xtjson.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/corpus.test.js test/parse.test.js test/stringify.test.js test/format.test.js",
    "bench": "node bench/bench.js"
  }
}
